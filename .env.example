# Chapter Smith Environment Configuration
# Copy this file to .env.local and fill in your values

# =============================================================================
# REQUIRED API KEYS
# =============================================================================

# Anthropic Claude API Key (Required)
# Get from: https://console.anthropic.com/
# Used for AI-powered chapter generation
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================

# Application URL (Required for production)
# Use your actual domain in production
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Environment mode
# Options: development, production, test
NODE_ENV=development

# =============================================================================
# PERFORMANCE & CACHING (Optional)
# =============================================================================

# Redis URL for distributed caching and rate limiting
# Recommended for production deployments
# Format: redis://username:password@host:port/database
# REDIS_URL=redis://localhost:6379

# Cache configuration
# CACHE_TTL_SECONDS=1800
# CACHE_MAX_SIZE=1000

# =============================================================================
# DATABASE (Optional)
# =============================================================================

# Database URL for analytics and persistent storage
# Recommended for production analytics
# Supports PostgreSQL, MySQL, SQLite
# DATABASE_URL=postgresql://user:password@localhost:5432/chaptersmith

# =============================================================================
# MONITORING & ANALYTICS (Optional)
# =============================================================================

# Sentry DSN for error tracking
# Get from: https://sentry.io/
# SENTRY_DSN=your_sentry_dsn_here

# Google Analytics Measurement ID
# GA_MEASUREMENT_ID=G-XXXXXXXXXX

# =============================================================================
# RATE LIMITING CONFIGURATION (Optional)
# =============================================================================

# Override default rate limits (requests per hour)
# RATE_LIMIT_TRANSCRIPT=100
# RATE_LIMIT_CHAPTERS=50
# RATE_LIMIT_EXPORT=200
# RATE_LIMIT_SRT=30
# RATE_LIMIT_GENERAL=1000

# Rate limiting window in milliseconds
# RATE_LIMIT_WINDOW_MS=3600000

# =============================================================================
# AI MODEL CONFIGURATION (Optional)
# =============================================================================

# Anthropic model selection
# Options: claude-3-haiku-20240307, claude-3-sonnet-20240229
ANTHROPIC_MODEL=claude-3-haiku-20240307

# AI model parameters
ANTHROPIC_MAX_TOKENS=4000
ANTHROPIC_TEMPERATURE=0.3

# =============================================================================
# SECURITY CONFIGURATION (Optional)
# =============================================================================

# CORS allowed origins (comma-separated)
# CORS_ORIGINS=https://yourdomain.com,https://app.yourdomain.com

# API request timeout (milliseconds)
# API_TIMEOUT_MS=60000

# Maximum file upload size (bytes)
# MAX_UPLOAD_SIZE=5242880

# =============================================================================
# DEVELOPMENT CONFIGURATION (Development Only)
# =============================================================================

# Enable debug logging
# DEBUG=chapter-smith:*

# Mock AI responses for development
# MOCK_AI_RESPONSES=false

# Disable rate limiting for development
# DISABLE_RATE_LIMITING=true

# =============================================================================
# WEBHOOK CONFIGURATION (Optional)
# =============================================================================

# Webhook URL for processing notifications
# WEBHOOK_URL=https://yourapp.com/webhooks/chapter-smith

# Webhook secret for signature verification
# WEBHOOK_SECRET=your_webhook_secret_here

# =============================================================================
# LOGGING CONFIGURATION (Optional)
# =============================================================================

# Log level
# Options: error, warn, info, debug
LOG_LEVEL=info

# Log format
# Options: json, pretty
LOG_FORMAT=pretty

# =============================================================================
# FEATURE FLAGS (Optional)
# =============================================================================

# Enable experimental features
# FEATURE_SEMANTIC_CACHING=true
# FEATURE_BATCH_PROCESSING=true
# FEATURE_GEOGRAPHIC_LIMITS=false

# =============================================================================
# DEPLOYMENT CONFIGURATION (Production)
# =============================================================================

# Health check endpoint timeout
# HEALTH_CHECK_TIMEOUT_MS=5000

# Graceful shutdown timeout
# SHUTDOWN_TIMEOUT_MS=10000

# Worker process configuration
# WORKER_PROCESSES=auto
# WORKER_MEMORY_LIMIT=512